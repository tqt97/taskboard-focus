{
  "name": "taskboard-focus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-default-type=module --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app lib docs tests package.json",
    "format:check": "prettier --check app lib docs tests package.json",
    "check": "npm run typecheck && npm run test && npm run format:check && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.10.1",
    "typescript": "^5.9.2"
  }
}
